# Copia este archivo como .env.local y llena los valores. .env.local NUNCA se sube al repo.

# --- Supabase (Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta Model API (Muse Spark, Muse Voice Transcribe) ---
MODEL_API_KEY=
META_API_URL=https://api.meta.ai/v1
MUSE_MODELO=muse-spark-1.3
MUSE_VOZ_MODELO=muse-voice-transcribe

# --- Modelo abierto (Muse Spark Open en Baseten) ---
MODELO_ABIERTO_URL=https://inference.baseten.co/v1
MODELO_ABIERTO_KEY=
MODELO_ABIERTO_ID=meta-models/muse-spark-open-1026

# --- Respaldo opcional (Muse Glimmer en NVIDIA) ---
NVIDIA_API_KEY=
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODELO=meta/muse-glimmer-30b

# --- App ---
# Zona horaria del planificador en minutos respecto a UTC (-240 = República Dominicana)
ZONA_OFFSET_MIN=-240

# true = el frontend usa datos de src/lib/mocks en vez de la API real
NEXT_PUBLIC_USAR_MOCKS=true

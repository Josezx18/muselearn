# Copia este archivo como .env.local y llena los valores. .env.local NUNCA se sube al repo.

# --- Supabase (Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta Model API (Muse Spark, Muse Voice Transcribe) ---
MODEL_API_KEY=
META_API_URL=https://api.meta.ai/v1
MUSE_MODELO=muse-spark-1.3
MUSE_VOZ_MODELO=muse-voice-transcribe-1.0

# --- Modelo abierto (Muse Spark Open en Baseten) ---
MODELO_ABIERTO_URL=https://inference.baseten.co/v1
MODELO_ABIERTO_KEY=
MODELO_ABIERTO_ID=meta-models/muse-spark-open-1026

# --- Respaldo opcional (Muse Glimmer en NVIDIA) ---
NVIDIA_API_KEY=
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODELO=meta/muse-glimmer-30b

# --- App ---
# Zona horaria del planificador en minutos respecto a UTC (-240 = República Dominicana)
ZONA_OFFSET_MIN=-240

# true = el frontend usa datos de src/lib/mocks en vez de la API real
NEXT_PUBLIC_USAR_MOCKS=true

# Topes diarios de IA por cuenta (opcional; valores por defecto en src/lib/db/limites.ts)
# LIMITE_TUTOR_DIA=60
# LIMITE_VERIFICACIONES_DIA=10
# LIMITE_TAREAS_DIA=20
# LIMITE_IA_DOCENTE_DIA=40

# --- Google ---
# Importar cursos de Google Classroom (cliente OAuth web; la URI de redirección es
# https://<tu-dominio>/api/integraciones/classroom/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# true = muestra "Continuar con Google" en Iniciar sesión y Crear cuenta. Actívalo cuando el proveedor
# Google esté configurado en Supabase (Authentication → Sign In / Providers → Google).
NEXT_PUBLIC_ENTRAR_CON_GOOGLE=false
